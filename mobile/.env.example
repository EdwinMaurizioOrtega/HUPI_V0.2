# Copiar a .env y ajustar. Expo carga este archivo automáticamente.
# Solo las variables con prefijo EXPO_PUBLIC_ llegan al bundle: nunca pongas
# secretos aquí, porque quedan visibles en la app compilada.

# URL del backend. Si se deja vacío la app funciona con datos locales (mocks).
# Dispositivo físico: usa la IP de tu equipo, no localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787

# development | production
APP_ENV=development

# En development el flujo de inicio se reinicia en cada recarga.
# Ponlo en false para conservar la sesión entre recargas.
DEV_ALWAYS_RESET_FLOW=true
