# Copiar a .env y ajustar. NUNCA commitear .env con credenciales reales.
DATABASE_URL=postgresql://usuario:password@localhost:5432/hupi_rust_db

# Secreto de firma JWT. Generar uno propio, por ejemplo: openssl rand -hex 32
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres

# development | production
APP_ENV=development

PORT=8787

# Orígenes permitidos por CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:8081
